<Window x:Class="Poker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Poker.ViewModels"
        xmlns:views="clr-namespace:Poker.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="900">
    <Window.Resources>
        <ControlTemplate TargetType="Button" x:Key="PageButtonStyle">
            <Border x:Name="border" Margin="3" Height="45" CornerRadius="5" BorderThickness="3" BorderBrush="Black" Background="LightGray">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="Gray"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Padding="20 5 0 3" Text="{Binding CurrentPageName}" FontSize="20" FontWeight="Bold"/>
        </Grid>
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentPageViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <views:GamePage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:GameInfoViewModel}">
                        <views:GameInfoPage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsPage/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Game"
                    Command="{Binding SelectPageCommand}"
                    CommandParameter="0"
                    Grid.Column="0" Template="{StaticResource PageButtonStyle}"/>
            <Button Content="Info"
                    Command="{Binding SelectPageCommand}"
                    CommandParameter="1"
                    Grid.Column="1" Template="{StaticResource PageButtonStyle}"/>
            <Button Content="Settings"
                    Command="{Binding SelectPageCommand}"
                    CommandParameter="2"
                    Grid.Column="2" Template="{StaticResource PageButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
