<UserControl x:Class="Poker.Views.Player"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Poker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="50" Margin="5">
            <Grid.Background>
                <ImageBrush ImageSource="/data/player.png" Stretch="Uniform"/>
            </Grid.Background>
        </Grid>
        <StackPanel Grid.Row="1">
            <Border BorderBrush="Black" BorderThickness="3" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0, 0" EndPoint="1,1">
                        <GradientStop Color="Blue" Offset="-0.3" />
                        <GradientStop Color="White" Offset="0.5" />
                        <GradientStop Color="Blue" Offset="1.3" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Player" TextAlignment="Center" 
                                    FontSize="10" FontWeight="Bold"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="3" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0, 0" EndPoint="1,1">
                        <GradientStop Color="Orange" Offset="-0.3" />
                        <GradientStop Color="WhiteSmoke" Offset="0.5" />
                        <GradientStop Color="Orange" Offset="1.3" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Money" TextAlignment="Center" 
                                    FontSize="10" FontStyle="Italic"
                                    Foreground="Green"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="3" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0, 0" EndPoint="1,1">
                        <GradientStop Color="LightBlue" Offset="-0.3" />
                        <GradientStop Color="BlueViolet" Offset="0.5" />
                        <GradientStop Color="LightBlue" Offset="1.3" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Current move" TextAlignment="Center" 
                        FontSize="10"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
