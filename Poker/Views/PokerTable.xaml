<UserControl x:Class="Poker.Views.CardTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Poker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:HalfConverter x:Key="HalfConverter"/>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="800" MinHeight="450">
            <Image Margin="50" Source="/data/pokertable.png" Stretch="Uniform" Canvas.Top="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualHeight, Converter={StaticResource HalfConverter}}">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                    <!-- Половина ширины и высоты кнопки -->
                </Image.RenderTransform>
            </Image>
            <Canvas>
                <local:Player Canvas.Left="50" Canvas.Top="50"
                        VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <local:Player Canvas.Top="50" Canvas.Left="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth, Converter={StaticResource HalfConverter}}"
                        VerticalAlignment="Top" HorizontalAlignment="Center">
                    <local:Player.RenderTransform>
                        <TranslateTransform X="-25" Y="-25"/>
                        <!-- Половина ширины и высоты кнопки -->
                    </local:Player.RenderTransform>
                </local:Player>
                <local:Player Canvas.Right="50" Canvas.Top="50"
                        VerticalAlignment="Top" HorizontalAlignment="Right"/>
                <local:Player Canvas.Left="50" Canvas.Bottom="50"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                <local:Player Canvas.Left="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, 
                Path=ActualWidth, Converter={StaticResource HalfConverter}}" Canvas.Bottom="50"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <local:Player.RenderTransform>
                        <TranslateTransform X="-25" Y="25"/>
                        <!-- Половина ширины и высоты кнопки -->
                    </local:Player.RenderTransform>
                </local:Player>
                <local:Player Canvas.Right="50" Canvas.Bottom="50"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
            </Canvas>
            <local:Bord HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </ScrollViewer>
</UserControl>
