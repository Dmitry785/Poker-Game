<UserControl x:Class="Poker.Views.Card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Poker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="250">
    <Grid Background="WhiteSmoke" MinHeight="90" MinWidth="50">
        <Image Source="{Binding CardImage}" Stretch="Uniform"/>
        <TextBlock Text="{Binding CardNumber}" VerticalAlignment="Top"/>
        <TextBlock Text="{Binding CardSuit}" VerticalAlignment="Bottom"/>
        <!--
        <TextBlock Margin="10" Padding="5" Text="{Binding CardSuit}" FontSize="16" Foreground="{Binding CardColor}" VerticalAlignment="Top" HorizontalAlignment="Right"/>
        <TextBlock Padding="5" Text="{Binding CardNumber}" FontSize="20" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Margin="10" Padding="5" Text="{Binding CardSuit}" FontSize="16" Foreground="{Binding CardColor}" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
        -->
    </Grid>
</UserControl>
