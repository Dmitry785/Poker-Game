<UserControl x:Class="Poker.Views.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Poker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="bold"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="Green">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <local:PokerTable DataContext="{Binding PokerTableViewModel}" Grid.Row="0"/>
        <Grid Grid.Row="1">
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding FoldCommand}" IsEnabled="{Binding CanFold}">Fold</Button>
                <Button Grid.Column="1" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}">Check</Button>
                <Button Grid.Column="2" Command="{Binding RaiseCommand}" IsEnabled="{Binding CanBetRaise}">Raise</Button>
                <Button Grid.Column="3" Command="{Binding CallCommand}" IsEnabled="{Binding CanCall}">Call</Button>
                <Slider Grid.Column="4" Minimum="{Binding MinBetRaise}" Maximum="{Binding MaxBetRaise}" Value="{Binding CurrentBet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="5" Text="{Binding CurrentBet}" Background="White" TextAlignment="Center" FontSize="20"/>
                <Button Grid.Column="6" Command="{Binding StartGameCommand}" IsEnabled="{Binding CanStartGame}">Start game</Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
