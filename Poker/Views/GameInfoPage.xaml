<UserControl x:Class="Poker.Views.GameInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Poker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:ReverseBool x:Key="reverseBool"/>
    </UserControl.Resources>
    <Grid Background="Goldenrod">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock>Your name</TextBlock>
                <TextBox Text="{Binding PlayerName, Mode=TwoWay,
                    UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsConnectedOrHosting, Converter={StaticResource reverseBool}}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0">Chat</TextBlock>
                <ListBox Grid.Row="1" ItemsSource="{Binding ChatLog}"></ListBox>
                <Grid Grid.Row="2" MinHeight="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ChatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Command="{Binding SendMessageToChat}" IsEnabled="{Binding IsConnectedOrHosting}">Send</Button>
                </Grid>
            </Grid>
        </Grid>
        <DockPanel Grid.Column="1">
            <TextBlock Text="Game log" DockPanel.Dock="Top"
                       FontSize="20" Padding="10 5 0 5"
                       FontStyle="Italic"/>
            <ListBox ItemsSource="{Binding GameLog}"/>
        </DockPanel>
    </Grid>
</UserControl>
