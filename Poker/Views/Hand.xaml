<UserControl x:Class="Poker.Views.Hand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Poker.Views"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="450">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <local:Card Grid.Column="0" Margin="1" DataContext="{Binding Card1}" Visibility="{Binding DataContext.Card1Visibility, RelativeSource={RelativeSource AncestorType=Grid}}"></local:Card>
        <local:Card Grid.Column="1" Margin="1" DataContext="{Binding Card2}" Visibility="{Binding DataContext.Card2Visibility, RelativeSource={RelativeSource AncestorType=Grid}}"></local:Card>
    </Grid>
</UserControl>
