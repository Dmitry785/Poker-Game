  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\SettingsPage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\GameInfoPage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="data\dealer.png" />
    <Resource Include="data\decks\default\cards_sheet.png" />
    <Resource Include="data\player.png" />
    <Resource Include="data\pokertable.png" />
  </ItemGroup>

</Project>
