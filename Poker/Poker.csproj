    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="data\dealer.png" />
    <None Remove="data\decks\default\cards_sheet.png" />
    <None Remove="data\player.png" />
